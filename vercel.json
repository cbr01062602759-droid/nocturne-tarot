{
  "version": 2,
  "builds": [
    {
      "src": "api/oracle.js",
      "use": "@vercel/node"
    },
    {
      "src": "*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/oracle",
      "dest": "/api/oracle.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
